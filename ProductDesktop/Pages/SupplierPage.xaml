<?xml version="1.0" encoding="utf-8" ?>
<VerticalStackLayout
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ProductDesktop.Pages.SupplierPage"
    Padding="20"
    Spacing="20"
    BackgroundColor="#F9FAFB">

    <!-- Header with Add Button -->
    <Grid ColumnDefinitions="*,Auto" Padding="0,0,0,10">
        <Label Text="🤝 Suppliers"
               FontSize="24"
               FontAttributes="Bold"
               TextColor="#111827"
               VerticalOptions="Center"/>
        <Button Text="➕ Add Supplier"
                BackgroundColor="#2563EB"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="10"
                Padding="16,8"
                HorizontalOptions="End"/>
    </Grid>

    <!-- Supplier Card -->
    <Border Stroke="#E5E7EB"
            StrokeThickness="1"
            BackgroundColor="White"
            Padding="16"
            StrokeShape="RoundRectangle 16"
            Shadow="2">
        <VerticalStackLayout Spacing="10">

            <!-- Supplier Info -->
            <Label Text="ABC Traders" FontSize="20" FontAttributes="Bold" TextColor="#1F2937"/>
            <Label Text="Contact: John Doe" FontSize="14" TextColor="#4B5563"/>
            <Label Text="Phone: 9876543210" FontSize="14" TextColor="#4B5563"/>
            <Label Text="Email: abc@traders.com" FontSize="14" TextColor="#4B5563"/>

            <!-- Divider -->
            <BoxView HeightRequest="1" Color="#E5E7EB" Margin="0,10"/>

            <!-- Actions -->
            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="12">
                <Button Text="📝 Edit"
                        Grid.Column="0"
                        BackgroundColor="#3B82F6"
                        TextColor="White"
                        FontSize="14"
                        CornerRadius="6"
                        Padding="12,6"/>
                <Button Text="🗑 Delete"
                        Grid.Column="1"
                        BackgroundColor="#EF4444"
                        TextColor="White"
                        FontSize="14"
                        CornerRadius="6"
                        Padding="12,6"/>
            </Grid>
        </VerticalStackLayout>
    </Border>

</VerticalStackLayout>
