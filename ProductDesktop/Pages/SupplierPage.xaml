<?xml version="1.0" encoding="utf-8" ?>
<VerticalStackLayout
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ProductDesktop.Pages.SupplierPage"
    Padding="20"
    Spacing="20"
    BackgroundColor="#F9FAFB">

    <!-- Header with Add Button -->
    <Grid ColumnDefinitions="*,Auto" Padding="0,0,0,10">
        <Label Text="🤝 Suppliers"
               FontSize="24"
               FontAttributes="Bold"
               TextColor="#111827"
               VerticalOptions="Center"/>
        <Button Text="➕ Add Supplier"
                BackgroundColor="#2563EB"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="10"
                Padding="16,8"
                HorizontalOptions="End"
                Clicked="Add_Supplier"/>
    </Grid>

    <!-- Supplier CollectionView -->
    <CollectionView ItemsSource="{Binding SupplierList}">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border Stroke="#E5E7EB"
                        StrokeThickness="1"
                        BackgroundColor="White"
                        Padding="16"
                        StrokeShape="RoundRectangle 16"
                        Shadow="2">
                    <VerticalStackLayout Spacing="12">

                        <!-- Supplier Name at the top, no label -->
                        <Label Text="{Binding SupplierName}"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#1F2937"/>

                        <!-- Info Rows (label + value side by side) -->
                        <Grid ColumnDefinitions="Auto,1*">
                            <Label Text="Supplier ID:" FontSize="12" TextColor="#4B5563"/>
                            <Label Text="{Binding SupplierId}" FontSize="14" FontAttributes="Bold"
                                   TextColor="#1F2937" Grid.Column="1" Margin="12,0,0,0"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,1*">
                            <Label Text="Contact Person:" FontSize="12" TextColor="#4B5563"/>
                            <Label Text="{Binding ContactPerson}" Grid.Column="1"
                                   FontSize="14" TextColor="#4B5563" Margin="12,0,0,0"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,1*">
                            <Label Text="Phone Number:" FontSize="12" TextColor="#4B5563"/>
                            <Label Text="{Binding PhoneNumber}" Grid.Column="1"
                                   FontSize="14" TextColor="#4B5563" Margin="12,0,0,0"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,1*">
                            <Label Text="Email:" FontSize="12" TextColor="#4B5563"/>
                            <Label Text="{Binding Email}" Grid.Column="1"
                                   FontSize="14" TextColor="#4B5563" Margin="12,0,0,0"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,1*">
                            <Label Text="Category:" FontSize="12" TextColor="#4B5563"/>
                            <Label Text="{Binding Category}" Grid.Column="1"
                                   FontSize="14" TextColor="#4B5563" Margin="12,0,0,0"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,1*">
                            <Label Text="Description:" FontSize="12" TextColor="#4B5563"/>
                            <Label Text="{Binding Description}" Grid.Column="1"
                                   FontSize="14" TextColor="#4B5563" Margin="12,0,0,0"/>
                        </Grid>

                        <!-- Divider -->
                        <BoxView HeightRequest="1" Color="#E5E7EB" Margin="0,10"/>

                        <!-- Action buttons (same row) -->
                        <Grid ColumnDefinitions="Auto,Auto,1*" ColumnSpacing="12">
                            <Button Text="📝 Edit"
                                    Grid.Column="0"
                                    BackgroundColor="#3B82F6"
                                    TextColor="White"
                                    FontSize="14"
                                    CornerRadius="6"
                                    Padding="12,6"/>

                            <Button Text="🗑 Delete"
                                    Grid.Column="1"
                                    BackgroundColor="#EF4444"
                                    TextColor="White"
                                    FontSize="14"
                                    CornerRadius="6"
                                    Padding="12,6"/>

                            <Button Text="🛒 Order"
                                    Grid.Column="2"
                                    BackgroundColor="#10B981"
                                    TextColor="White"
                                    FontSize="14"
                                    CornerRadius="6"
                                    Padding="12,6"
                                    HorizontalOptions="End"/>
                        </Grid>

                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</VerticalStackLayout>
