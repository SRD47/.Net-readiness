<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ProductDesktop.Pages.ProductsTablePage"
    Title="Product Table"
    BackgroundColor="#F9FAFB">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label
                Text="📋 Product Inventory"
                FontSize="26"
                FontAttributes="Bold"
                TextColor="#111827" />

            <!-- Table Header -->
            <Grid ColumnSpacing="10" RowSpacing="0" Padding="10" BackgroundColor="#E5E7EB">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Label Text="Name" FontAttributes="Bold" />
                <Label Grid.Column="1" Text="Quantity" FontAttributes="Bold" />
                <Label Grid.Column="2" Text="Status" FontAttributes="Bold" />
                <Label Grid.Column="3" Text="Actions" FontAttributes="Bold" />
            </Grid>

            <!-- Table Rows -->
            <CollectionView
                ItemsSource="{Binding ProductList}"
                SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="10" RowSpacing="0" Padding="10" BackgroundColor="White" Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Label Text="{Binding Name}" TextColor="#374151" />
                            <Label Grid.Column="1" Text="{Binding Quantity}" TextColor="#4B5563" />
                            <Label Grid.Column="2" Text="In Stock" TextColor="#10B981" />

                            <!-- Actions -->
                            <HorizontalStackLayout Grid.Column="3" Spacing="10">
                                <ImageButton Source="edit.png" HeightRequest="24" WidthRequest="24"  />
                                <ImageButton Source="delete.png" HeightRequest="24" WidthRequest="24" />
                            </HorizontalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
