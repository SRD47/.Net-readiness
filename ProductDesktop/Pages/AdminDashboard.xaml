<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ProductDesktop.Pages.AdminDashboard"
    Title="⚡ Admin Control Center"
    BackgroundColor="#F8F9FA">

    <ContentPage.Resources>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="#212529" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="HorizontalOptions" Value="Fill" />
            <Setter Property="Margin" Value="0,10" />
            <Setter Property="Padding" Value="10,15" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </ContentPage.Resources>

    <Grid ColumnDefinitions="200,*" Padding="0">

        <!-- Sidebar -->
        <StackLayout BackgroundColor="White" Padding="20" Spacing="20">
            <Label Text="⚙️ Admin Panel"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#111827"
                   Margin="0,0,0,20"/>

            <Button x:Name="UsersButton"
                    Text="Users"
                    Style="{StaticResource SidebarButton}"
                    Clicked="ShowStaffForm" />

            <Button x:Name="ProductButton"
                    Text="Product"
                    Style="{StaticResource SidebarButton}"
                    Clicked="ShowProductForm" />
        </StackLayout>

        <!-- Main Content -->
        <ScrollView Grid.Column="1" Padding="20">
            <VerticalStackLayout Spacing="20">

                <!-- Staff Form -->
                <VerticalStackLayout x:Name="StaffForm" IsVisible="True" Spacing="20">
                    <Border BackgroundColor="White" Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.15" Offset="4,4" Radius="10"/>
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="20">
                            <Label Text="👤 Add New Staff"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#212529"/>

                            <Entry x:Name="staff_name"
                                   Placeholder="Enter the name"
                                   BackgroundColor="#F1F3F5"
                                   TextColor="Black"/>

                            <Entry x:Name="staff_username"
                                   Placeholder="Enter the username"
                                   BackgroundColor="#F1F3F5"
                                   TextColor="Black"/>

                            <Entry x:Name="pass"
                                   Placeholder="Enter the password"
                                   BackgroundColor="#F1F3F5"
                                   IsPassword="True"
                                   TextColor="Black"/>

                            <Entry x:Name="confirm_pass"
                                   Placeholder="Confirm the password"
                                   BackgroundColor="#F1F3F5"
                                   IsPassword="True"
                                   TextColor="Black"/>

                            <Picker x:Name="staff_role"
                                    Title="Select a role"
                                    BackgroundColor="#F1F3F5"
                                    TextColor="Black"
                                    TitleColor="#6C757D"
                                    ItemsSource="{Binding Rolesbind}"/>

                            <Button Text="➕ Add Staff"
                                    BackgroundColor="#4C6EF5"
                                    TextColor="White"
                                    CornerRadius="25"
                                    HeightRequest="45"
                                    FontAttributes="Bold"
                                    Clicked="Staff_Button"/>

                            <Label Text="Change roles of an existing staff? Click here"
                                   FontSize="13"
                                   HorizontalOptions="Center"
                                   TextColor="#4C6EF5">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </VerticalStackLayout>
                    </Border>

                    <!-- User List Table -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="👥 Existing Users"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#212529" />

                        <!-- Table Header -->
                        <Grid ColumnDefinitions="2*,2*,*,*,Auto" Padding="10,5" BackgroundColor="#E9ECEF">
                            <Label Text="Name" FontAttributes="Bold" />
                            <Label Text="Username" FontAttributes="Bold" Grid.Column="1"/>
                            <Label Text="Role" FontAttributes="Bold" Grid.Column="2"/>
                            <Label Text="Edit" FontAttributes="Bold" Grid.Column="3"/>
                            <Label Text="Delete" FontAttributes="Bold" Grid.Column="4"/>
                        </Grid>

                        <!-- User Rows -->
                        <CollectionView ItemsSource="{Binding UserList}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="2*,2*,*,*,Auto" Padding="10,5" ColumnSpacing="10" BackgroundColor="White">
                                        <Label Text="{Binding Name}" Grid.Column="0"/>
                                        <Label Text="{Binding Username}" Grid.Column="1"/>
                                        <Label Text="{Binding Roles}" Grid.Column="2"/>

                                        <ImageButton Source="edit.png"
                                                     WidthRequest="20"
                                                     HeightRequest="20"
                                                     BackgroundColor="Transparent"
                                                     Grid.Column="3" />

                                        <ImageButton Source="delete.png"
                                                     WidthRequest="20"
                                                     HeightRequest="20"
                                                     BackgroundColor="Transparent"
                                                     Grid.Column="4" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Product Form -->
                <VerticalStackLayout x:Name="ProductForm" IsVisible="False" Spacing="20">
                    <Border BackgroundColor="White" Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.15" Offset="4,4" Radius="10"/>
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="20">
                            <Label Text="📦 Add New Product"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#212529"/>

                            <Entry x:Name="product_name"
                                   Placeholder="Product Name"
                                   BackgroundColor="#F1F3F5"
                                   TextColor="Black"/>

                            <Entry x:Name="product_category"
                                   Placeholder="Category"
                                   BackgroundColor="#F1F3F5"
                                   TextColor="Black"/>

                            <Entry x:Name="product_quantity"
                                   Keyboard="Numeric"
                                   Placeholder="Quantity"
                                   BackgroundColor="#F1F3F5"
                                   TextColor="Black"
                                   TextChanged="product_quantity_TextChanged"/>

                            <Entry x:Name="stock_number"
                                   Keyboard="Numeric"
                                   Placeholder="Stock Number"
                                   BackgroundColor="#F1F3F5"
                                   TextColor="Black"
                                   TextChanged="stock_number_TextChanged"/>

                            <Picker x:Name="selected_currency"
                                    Title="Select currency"
                                    BackgroundColor="#F1F3F5"
                                    TextColor="Black"
                                    TitleColor="#6C757D"
                                    ItemsSource="{Binding Currencies}"/>

                            <Entry x:Name="product_price"
                                   Placeholder="Price"
                                   Keyboard="Numeric"
                                   BackgroundColor="#F1F3F5"
                                   TextColor="Black"
                                   TextChanged="price_TextChanged"/>

                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                <Label Text="Add Image Source:" TextColor="#495057" VerticalOptions="Center"/>
                                <Button Text="Upload" BackgroundColor="#20C997" TextColor="White" CornerRadius="20" Padding="15,5"/>
                            </HorizontalStackLayout>

                            <Button Text="➕ Add Product"
                                    BackgroundColor="#E64980"
                                    TextColor="White"
                                    CornerRadius="25"
                                    HeightRequest="45"
                                    FontAttributes="Bold"
                                    Clicked="Prouct_Add"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
