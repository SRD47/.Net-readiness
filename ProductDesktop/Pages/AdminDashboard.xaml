<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProductDesktop.Pages.AdminDashboard"
             Title="⚡ Admin Control Center"
             BackgroundColor="#F8F9FA">

    <ScrollView>
        <Grid ColumnDefinitions="*,*" Padding="20" RowSpacing="20" ColumnSpacing="20">

            <!-- Staff Management Card -->
            <Border Grid.Column="0"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 20"
                    Stroke="#E0E0E0"
                    Padding="20">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.15" Offset="4,4" Radius="10"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="20">
                    <Label Text="👤 Add New Staff"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#212529"/>

                    <Entry x:Name="staff_name"
                           Placeholder="Enter the name"
                           BackgroundColor="#F1F3F5"
                           TextColor="Black"/>

                    <Entry x:Name="staff_username"
                           Placeholder="Enter the username"
                           BackgroundColor="#F1F3F5"
                           TextColor="Black"/>

                    <Entry x:Name="pass"
                           Placeholder="Enter the password"
                           BackgroundColor="#F1F3F5"
                           IsPassword="True"
                           TextColor="Black"/>

                    <Entry x:Name="confirm_pass"
                           Placeholder="Confirm the password"
                           BackgroundColor="#F1F3F5"
                           IsPassword="True"
                           TextColor="Black"/>

                    <Picker x:Name="staff_role"
                            Title="Select a role"
                            BackgroundColor="#F1F3F5"
                            TextColor="Black"
                            TitleColor="#6C757D"
                            ItemsSource="{Binding Rolesbind}"/>

                    <Button Text="➕ Add Staff"
                            BackgroundColor="#4C6EF5"
                            TextColor="White"
                            CornerRadius="25"
                            HeightRequest="45"
                            FontAttributes="Bold"
                            Clicked="Staff_Button"/>

                    <Label Text="Change roles of an existing staff? Click here"
                           FontSize="13"
                           HorizontalOptions="Center"
                           TextColor="#4C6EF5">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <!-- Product Management Card -->
            <Border Grid.Column="1"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 20"
                    Stroke="#E0E0E0"
                    Padding="20">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.15" Offset="4,4" Radius="10"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="20">
                    <Label Text="📦 Add New Product"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#212529"/>

                    <Entry x:Name="product_name"
                           Placeholder="Product Name"
                           BackgroundColor="#F1F3F5"
                           TextColor="Black"/>

                    <Entry x:Name="product_category"
                           Placeholder="Category"
                           BackgroundColor="#F1F3F5"
                           TextColor="Black"/>

                    <Entry x:Name="product_quantity"
                           Keyboard="Numeric"
                           Placeholder="Quantity"
                           BackgroundColor="#F1F3F5"
                           TextColor="Black"
                           TextChanged="product_quantity_TextChanged"/>

                    <Entry x:Name="stock_number"
                           Keyboard="Numeric"
                           Placeholder="Stock Number"
                           BackgroundColor="#F1F3F5"
                           TextColor="Black"
                           TextChanged="stock_number_TextChanged"/>

                    <Picker x:Name="selected_currency"
                            Title="Select currency"
                            BackgroundColor="#F1F3F5"
                            TextColor="Black"
                            TitleColor="#6C757D"
                            ItemsSource="{Binding Currencies}"/>

                    <Entry x:Name="product_price"
                           Placeholder="Price"
                           Keyboard="Numeric"
                           BackgroundColor="#F1F3F5"
                           TextColor="Black"
                           TextChanged="price_TextChanged"/>

                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="Product Image:"
                               TextColor="#495057"
                               VerticalOptions="Center"/>
                        <Button Text="Upload"
                                BackgroundColor="#20C997"
                                TextColor="White"
                                CornerRadius="20"
                                Padding="15,5"/>
                    </HorizontalStackLayout>

                    <Button Text="➕ Add Product"
                            BackgroundColor="#E64980"
                            TextColor="White"
                            CornerRadius="25"
                            HeightRequest="45"
                            FontAttributes="Bold"
                            Clicked="Prouct_Add"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
