<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ProductDesktop.Pages.InventoryManager"
    Title="📦 Inventory Manager"
    BackgroundColor="#F9FAFB">

    <ContentPage.Resources>
        <!-- Sidebar Button Style -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="HorizontalOptions" Value="Fill"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <!-- Selected Sidebar Button -->
        <Style x:Key="SidebarButtonSelected" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
            <Setter Property="BackgroundColor" Value="#374151"/>
        </Style>
    </ContentPage.Resources>

    <Grid ColumnDefinitions="200,*">

        <!-- Sidebar -->
        <VerticalStackLayout BackgroundColor="#1F2937" Padding="20" Spacing="12">
            <Label Text="📦 Inventory"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="White"
                   Margin="0,0,0,20"/>

            <!-- Dashboard -->
            <Button x:Name="DashboardBtn"
                    Text="🏠 Dashboard"
                    Style="{StaticResource SidebarButton}"
                    Clicked="DashboardBtn_Clicked"/>

            <!-- Products -->
            <Button x:Name="ProductsBtn"
                    Text="📋 Products"
                    Style="{StaticResource SidebarButton}"
                    Clicked="ProductsBtn_Clicked"/>
        </VerticalStackLayout>

        <!-- Main Content -->
        <ScrollView Grid.Column="1" Padding="20">
            <Grid>

                <!-- Dashboard Section -->
                <VerticalStackLayout x:Name="DashboardSection" IsVisible="True" Spacing="20">
                    <Border BackgroundColor="White" Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout>
                            <Label Text="📊 Dashboard Overview"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#111827"/>
                            <Label Text="Total Products: 120" FontSize="16" TextColor="#374151"/>
                            <Label Text="Low Stock Items: 8" FontSize="16" TextColor="#DC2626"/>
                            <Label Text="Pending Orders: 5" FontSize="16" TextColor="#2563EB"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Products Section -->
                <VerticalStackLayout x:Name="ProductsSection" IsVisible="False" Spacing="20">
                    <Border BackgroundColor="White" Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="15">

                            <!-- Header Grid with Title + Add Button -->
                            <Grid ColumnDefinitions="*,Auto" Padding="0,0,0,10">
                                <Label Text="📋 Products"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="#111827"
                                       VerticalOptions="Center"/>
                                <Button Text="+ Add Product"
                                        BackgroundColor="#3B82F6"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        CornerRadius="8"
                                        Padding="15,6"
                                        HorizontalOptions="End"/>
                            </Grid>

                            <!-- Table Header -->
                            <Grid ColumnDefinitions="2*,*,*,Auto,Auto"
                                  Padding="10,8"
                                  ColumnSpacing="20"
                                  BackgroundColor="#F3F4F6">
                                <Label Text="Name" FontAttributes="Bold" TextColor="#111827"/>
                                <Label Text="Category" Grid.Column="1" FontAttributes="Bold" TextColor="#111827"/>
                                <Label Text="Quantity" Grid.Column="2" FontAttributes="Bold" TextColor="#111827"/>
                                <Label Text="Edit" Grid.Column="3" FontAttributes="Bold" TextColor="#111827"/>
                                <Label Text="Delete" Grid.Column="4" FontAttributes="Bold" TextColor="#111827"/>
                            </Grid>

                            <!-- Table Rows -->
                            <CollectionView ItemsSource="{Binding ProductList}" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Each Row -->
                                        <VerticalStackLayout Spacing="0" Padding="0">
                                            <Grid ColumnDefinitions="2*,*,*,Auto,Auto"
                                                  ColumnSpacing="20"
                                                  Padding="10,8"
                                                  VerticalOptions="Center">

                                                <!-- Product Info -->
                                                <Label Text="{Binding Name}" Grid.Column="0" FontSize="14" TextColor="#374151"/>
                                                <Label Text="{Binding Category}" Grid.Column="1" FontSize="14" TextColor="#374151"/>
                                                <Label Text="{Binding Quantity}" Grid.Column="2" FontSize="14" TextColor="#374151"/>

                                                <!-- Edit -->
                                                <Image Grid.Column="3"
                                                       Source="edit.png"
                                                       HeightRequest="20"
                                                       WidthRequest="20"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       Margin="0,0,10,0">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="Edit_Button" />
                                                    </Image.GestureRecognizers>
                                                </Image>

                                                <!-- Delete -->
                                                <Image Grid.Column="4"
                                                       Source="delete.png"
                                                       HeightRequest="20"
                                                       WidthRequest="20"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"/>
                                            </Grid>

                                            <!-- Row Divider -->
                                            <BoxView HeightRequest="1" Color="#E5E7EB" HorizontalOptions="Fill" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
