<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:ProductDesktop.Pages"
    x:Class="ProductDesktop.Pages.InventoryManager"
    Title="📦 Inventory Manager"
    BackgroundColor="#F9FAFB">

    <ContentPage.Resources>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="HorizontalOptions" Value="Fill"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <Style x:Key="SidebarButtonSelected" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
            <Setter Property="BackgroundColor" Value="#374151"/>
        </Style>
    </ContentPage.Resources>

    <Grid ColumnDefinitions="200,*">

        <Grid BackgroundColor="#3A3A3A" Padding="20" RowDefinitions="*,Auto">
            <VerticalStackLayout Spacing="12" Grid.Row="0">
                <Label Text="📦 Inventory"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="White"
                       Margin="0,0,0,20"/>

                <Button x:Name="DashboardBtn"
                        Text="🏠 Dashboard"
                        Style="{StaticResource SidebarButton}"
                        Clicked="DashboardBtn_Clicked"/>

                <Button x:Name="ProductsBtn"
                        Text="📋 Products"
                        Style="{StaticResource SidebarButton}"
                        Clicked="ProductsBtn_Clicked"/>
                
                <Button x:Name="SuppliersBtn"
                        Text="📦 Suppliers"
                        Style="{StaticResource SidebarButton}"
                        Clicked="SuppliersBtn_Clicked"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="1" HorizontalOptions="Center" Spacing="2" Margin="0,20,0,0">
                <ImageButton x:Name="LogoutBtn"
                             Source="logout.png"
                             WidthRequest="32"
                             HeightRequest="32"
                             BackgroundColor="Transparent"
                             HorizontalOptions="Center"
                             Clicked="LogoutBtn_Clicked"/>
                <Label Text="Logout"
                       FontSize="12"
                       TextColor="#D1D5DB"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Column="1" Padding="20">
            <Grid>

                <VerticalStackLayout x:Name="DashboardSection" IsVisible="True" Spacing="20">
                    <Border BackgroundColor="White" Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout>
                            <Label Text="📊 Dashboard Overview"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#111827"/>
                            <Label Text="Total Products: 120" FontSize="16" TextColor="#374151"/>
                            <Label Text="Low Stock Items: 8" FontSize="16" TextColor="#DC2626"/>
                            <Label Text="Pending Orders: 5" FontSize="16" TextColor="#2563EB"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="ProductsSection" IsVisible="False" Spacing="20">
                    <Border BackgroundColor="White" Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="15">

                            <Grid ColumnDefinitions="*,Auto" Padding="0,0,0,10">
                                <Label Text="📋 Products"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="#111827"
                                       VerticalOptions="Center"/>
                                <Button Text="Add Product"
                                        BackgroundColor="#3B82F6"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        CornerRadius="8"
                                        Padding="15,6"
                                        HorizontalOptions="End"
                                        Clicked="ShowProductPopup"/>
                            </Grid>
                            

                            <Grid ColumnDefinitions="2*,*,*,Auto,Auto"
                                  Padding="10,8"
                                  ColumnSpacing="20"
                                  BackgroundColor="#F3F4F6">
                                <Label Text="Name" FontAttributes="Bold" TextColor="#111827"/>
                                <Label Text="Category" Grid.Column="1" FontAttributes="Bold" TextColor="#111827"/>
                                <Label Text="Stock" Grid.Column="2" FontAttributes="Bold" TextColor="#111827"/>
                                <Label Text="Edit" Grid.Column="3" FontAttributes="Bold" TextColor="#111827"/>
                                <Label Text="Delete" Grid.Column="4" FontAttributes="Bold" TextColor="#111827"/>
                            </Grid>

                            <CollectionView ItemsSource="{Binding ProductList}" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Spacing="0" Padding="0">
                                            <Grid ColumnDefinitions="2*,*,*,Auto,Auto"
                                                  ColumnSpacing="20"
                                                  Padding="10,8"
                                                  VerticalOptions="Center">
                                                <Label Text="{Binding Name}" Grid.Column="0" FontSize="14" TextColor="#374151"/>
                                                <Label Text="{Binding Category}" Grid.Column="1" FontSize="14" TextColor="#374151"/>
                                                <Label Text="{Binding Stock}" Grid.Column="2" FontSize="14" TextColor="#374151"/>

                                                <Image Grid.Column="3"
                                                       Source="edit.png"
                                                       HeightRequest="20"
                                                       WidthRequest="20"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       Margin="0,0,10,0">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="Edit_Button" />
                                                    </Image.GestureRecognizers>
                                                </Image>

                                                <Image Grid.Column="4"
                                                       Source="delete.png"
                                                       HeightRequest="20"
                                                       WidthRequest="20"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"/>
                                            </Grid>
                                            <BoxView HeightRequest="1" Color="#E5E7EB" HorizontalOptions="Fill" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="SuppliersSection" IsVisible="False" Spacing="20">
                    <Border BackgroundColor="White" Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>

                        <!-- Load SupplierPage.xaml layout here -->
                        <pages:SupplierPage />
                    </Border>
                </VerticalStackLayout>


            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
