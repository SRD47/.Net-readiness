<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:ProductDesktop.Pages"
    xmlns:viewmodel="clr-namespace:ProductDesktop.ViewModel"
    xmlns:converter="clr-namespace:ProductDesktop.Converter"
    xmlns:entities="clr-namespace:ProductDesktop.Entities"
    x:Class="ProductDesktop.Pages.InventoryManager"
    
    x:DataType="viewmodel:MainViewModel"
    Title="📦 Inventory Manager"
    BackgroundColor="#F9FAFB">

    <ContentPage.Resources>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="HorizontalOptions" Value="Fill"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <ResourceDictionary>
            <converter:ColorConverter x:Key="ColorConverter"/>
        </ResourceDictionary>

        <Style x:Key="SidebarButtonSelected" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
            <Setter Property="BackgroundColor" Value="#374151"/>
        </Style>
    </ContentPage.Resources>

    <Grid ColumnDefinitions="200,*">
        <!-- Sidebar -->
        <Grid BackgroundColor="#3A3A3A" Padding="20" RowDefinitions="*,Auto">
            <VerticalStackLayout Spacing="12" Grid.Row="0">
                <Label Text="📦 Inventory"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="White"
                       Margin="0,0,0,20"/>

                <Button x:Name="DashboardBtn"
                        Text="🏠 Dashboard"
                        Style="{StaticResource SidebarButton}"
                        Clicked="DashboardBtn_Clicked"/>

                <Button x:Name="ProductsBtn"
                        Text="📋 Products"
                        Style="{StaticResource SidebarButton}"
                        Clicked="ProductsBtn_Clicked"/>

                <Button x:Name="SuppliersBtn"
                        Text="📦 Suppliers"
                        Style="{StaticResource SidebarButton}"
                        Clicked="SuppliersBtn_Clicked"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="1" HorizontalOptions="Center" Spacing="2" Margin="0,20,0,0">
                <ImageButton x:Name="LogoutBtn"
                             Source="logout.png"
                             WidthRequest="32"
                             HeightRequest="32"
                             BackgroundColor="Transparent"
                             HorizontalOptions="Center"
                             Clicked="LogoutBtn_Clicked"/>
                <Label Text="Logout"
                       FontSize="12"
                       TextColor="#D1D5DB"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>
        <ScrollView Grid.Column="1" Padding="20">
            <Grid>
                <!-- Dashboard Section -->
                <VerticalStackLayout x:Name="DashboardSection" IsVisible="True" Spacing="20">
                    <Border BackgroundColor="White" Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout>
                            <Label Text="📊 Dashboard Overview"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#111827"/>
                            <Label x:Name="TotalProductsNum" FontSize="16" TextColor="#374151"/>
                            <Label x:Name="LowStockNum" FontSize="16" TextColor="#DC2626"/>
                            <Label x:Name="PendingOrderNum" FontSize="16" TextColor="#2563EB"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Orders Panel -->
                    <Border BackgroundColor="White" Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="12">
                            <Label Text="Orders Panel"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#111827"/>

                            <SearchBar Placeholder="Search orders..."
                                       FontSize="14"
                                       TextColor="#111827"
                                       PlaceholderColor="#9CA3AF"
                                       BackgroundColor="#E5E7EB"
                                       CancelButtonColor="#6B7280"
                                       Margin="0,0,0,10"
                                       TextChanged="OrdersPanel_TextChanged"
                                       />
                            
                            <CollectionView ItemsSource="{Binding StaffViewModel.OrdersList}" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="entities:Order">
                                        <Border BackgroundColor="White"
                                                Padding="20"
                                                Margin="0,10"
                                                Stroke="#E5E7EB"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle"
                                                Shadow="2">

                                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">

                                                <Label Text="{Binding Id, StringFormat='Order #{0}'}"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       TextColor="#1F2937"
                                                       Grid.Row="0"
                                                       Grid.Column="0" />

                                                <Label Text="{Binding OrderStatus}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="{Binding OrderStatus, Converter={StaticResource ColorConverter}}"
                                                       HorizontalOptions="End"
                                                       Grid.Row="0"
                                                       Grid.Column="1" />

                                                <Label Text="{Binding Supplier.SupplierName, StringFormat='Supplier: {0}'}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="#374151"
                                                       Grid.Row="1"
                                                       Grid.ColumnSpan="2" />

                                                <Label Text="{Binding ProductName, StringFormat='Product: {0}'}"
                                                       FontSize="14"
                                                       TextColor="#374151"
                                                       Grid.Row="2"
                                                       Grid.ColumnSpan="2" />

                                                <Label Text="{Binding SupplierId, StringFormat='Supplier ID: {0}'}"
                                                       FontSize="13"
                                                       TextColor="#6B7280"
                                                       Grid.Row="3"
                                                       Grid.ColumnSpan="2" />

                                                <Label Text="{Binding ExpectedDeliveryDate, StringFormat='Expected: {0:MMM d, yyyy}'}"
                                                       FontSize="13"
                                                       TextColor="#6B7280"
                                                       Grid.Row="4"
                                                       Grid.ColumnSpan="2" />

                                                <Picker Title="Update Status:"
                                                        TitleColor="Black"
                                                        ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:MainViewModel}}, Path=EnumViewModel.OrderStatus}"
                                                        SelectedItem="{Binding OrderStatus, Mode=TwoWay}"
                                                        FontSize="14"
                                                        Margin="0,8,0,4"
                                                        TextColor="#1F2937"
                                                        BackgroundColor="#F3F4F6"
                                                        Grid.Row="5"
                                                        Grid.ColumnSpan="2" />

                                                <HorizontalStackLayout Grid.Row="6"
                                                                       Grid.ColumnSpan="2"
                                                                       Spacing="10"
                                                                       Margin="0,10,0,0">
                                                    <Button Text="Reorder"
                                                            BackgroundColor="#3B82F6"
                                                            TextColor="White"
                                                            FontAttributes="Bold"
                                                            CornerRadius="8"
                                                            Padding="10,6"
                                                            FontSize="14"
                                                            CommandParameter="{Binding .}"
                                                            Clicked="ReorderBtn_Clicked" />

                                                    <Button Text="Delete"
                                                            BackgroundColor="#EF4444"
                                                            TextColor="White"
                                                            FontAttributes="Bold"
                                                            CornerRadius="8"
                                                            Padding="10,6"
                                                            FontSize="14"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:MainViewModel}}, Path=DeleteOrderCommand}"
                                                            CommandParameter="{Binding .} " 
                                                            />
                                                </HorizontalStackLayout>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>   
                </VerticalStackLayout>

                <!-- Products -->
                <VerticalStackLayout x:Name="ProductsSection" IsVisible="False" Spacing="20">
                    <Border BackgroundColor="White" Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="15">

                            <Grid ColumnDefinitions="*,Auto" Padding="0,0,0,10">
                                <Label Text="📋 Products"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="#111827"
                                       VerticalOptions="Center"/>
                                <Button Text="Add Product"
                                        BackgroundColor="#3B82F6"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        CornerRadius="8"
                                        Padding="15,6"
                                        HorizontalOptions="End"
                                        Clicked="ShowProductPopup"/>
                            </Grid>

                           
                            <!-- Products List -->
                            <CollectionView ItemsSource="{Binding EnumViewModel.Categories}"
                                            SelectionMode="Single"
                                            SelectedItem="{Binding EnumViewModel.Selectedcategory}"
                                            Margin="0,0,0,10"
                                            HeightRequest="60"
                                            BackgroundColor="Transparent"
                                            HorizontalScrollBarVisibility="Always">

                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10"/>
                                </CollectionView.ItemsLayout>

                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border StrokeShape="RoundRectangle"
                                                StrokeThickness="1"
                                                Stroke="LightGray"
                                                BackgroundColor="White"
                                                Padding="16,10"
                                                MinimumWidthRequest="100"
                                                HorizontalOptions="Start"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding .}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="Black"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <CollectionView ItemsSource="{Binding EnumViewModel.FilterCategory}"
                                            Margin="0,10,0,0"
                                            SelectionMode="None"
                                            EmptyView="No products found for this category.">
                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical" Span="2" />
                                </CollectionView.ItemsLayout>

                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="entities:Product">
                                        <Border Stroke="#E5E7EB"
                                                StrokeThickness="1"
                                                Padding="16"
                                                Margin="8"
                                                BackgroundColor="White"
                        >       
                                            <VerticalStackLayout Spacing="10">

                                                <Label Text="{Binding Name}"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       TextColor="#111827"
                                                       LineBreakMode="TailTruncation" />

                                                <Label Text="{Binding Category}"
                                                       FontSize="14"
                                                       TextColor="#6B7280" />

                                                <HorizontalStackLayout Spacing="6">
                                                    <Label Text="Price:"
                                                           FontSize="14"
                                                           TextColor="#4B5563" />
                                                    <Label Text="{Binding Price, StringFormat='{}{0:F2}'}"
                                                           FontSize="14"
                                                           FontAttributes="Bold"
                                                           TextColor="#10B981" />
                                                    <Label Text="{Binding Currency}"
                                                           FontSize="14"
                                                           TextColor="#10B981" />
                                                </HorizontalStackLayout>

                                                <HorizontalStackLayout Spacing="6">
                                                    <Label Text="Stock:"
                                                           FontSize="14"
                                                           TextColor="#4B5563" />
                                                    <Label Text="{Binding Stock}"
                                                           FontSize="14"
                                                           FontAttributes="Bold"
                                                           TextColor="{Binding Stock, Converter={StaticResource StockColorConverter}}" />
                                                </HorizontalStackLayout>

                                                <Button Text="View Details"
                                                        BackgroundColor="#3B82F6"
                                                        TextColor="White"
                                                        CornerRadius="6"
                                                        Padding="10,6"
                                                        CommandParameter="{Binding .}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>


                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Suppliers -->
                <VerticalStackLayout x:Name="SuppliersSection" IsVisible="False" Spacing="20">
                    <Border BackgroundColor="White" Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <pages:SupplierPage />  
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
 