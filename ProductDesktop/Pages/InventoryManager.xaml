<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ProductDesktop.Pages.InventoryManager"
    BackgroundColor="#E0E7FF">

    <Grid Padding="20" RowSpacing="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label
                Text="Inventory Manager"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="#2a3f54" />
            <Button
                Grid.Column="1"
                Text="Add"
                BackgroundColor="#3b82f6"
                TextColor="White"
                CornerRadius="10"
                Padding="15,8"
                FontAttributes="Bold" />
        </Grid>

        <Border
            Grid.Row="1"
            Margin="0,10,0,0"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 15"
            BackgroundColor="White"
            Padding="5">
            <SearchBar
                Placeholder="Search inventory..."
                BackgroundColor="Transparent"
                TextColor="#2a3f54"
                PlaceholderColor="#9ca3af"
                HeightRequest="40" />
        </Border>

        <CollectionView
            Grid.Row="2"
            Margin="0,10,0,0"
            ItemsSource="{Binding ProductList}"
            SelectedItem="{Binding SelectedProduct}"
            SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="0,12"
                        Padding="15"
                        StrokeShape="RoundRectangle 15"
                        BackgroundColor="White"
                        StrokeThickness="0">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="2,2" Radius="6" Opacity="0.1" />
                        </Border.Shadow>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal" />
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#E5E7EB" />
                                        <!-- Light Gray -->
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid ColumnSpacing="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackLayout>
                                <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="#1e293b" />
                                <Label Text="{Binding Quantity, StringFormat='Quantity: {0}'}" TextColor="#64748b" />
                                <Label Text="In Stock" TextColor="Green" FontAttributes="Italic" />
                            </StackLayout>

                            <Button
                                Grid.Column="1"
                                Text="✏️"
                                BackgroundColor="#F3F4F6"
                                FontSize="20"
                                CornerRadius="8"
                                WidthRequest="44"
                                HeightRequest="44"
                                Padding="6"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" 
                                Clicked="Edit_Button"/>

                            <Button
                                Grid.Column="2"
                                Text="🗑️"
                                BackgroundColor="#FEE2E2"
                                FontSize="20"
                                TextColor="#DC2626"
                                CornerRadius="8"
                                WidthRequest="44"
                                HeightRequest="44"
                                Padding="6"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" 
                                Clicked="Delete_Button"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
