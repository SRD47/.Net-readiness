<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:ProductDesktop.Pages"
    xmlns:viewmodel="clr-namespace:ProductDesktop.ViewModel"
    xmlns:entities="clr-namespace:ProductDesktop.Entities"
    x:Class="ProductDesktop.Pages.InventoryManager"
    x:DataType="viewmodel:MainViewModel"
    Title="📦 Inventory Manager"
    BackgroundColor="#F9FAFB">

    <ContentPage.Resources>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="HorizontalOptions" Value="Fill"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <Style x:Key="SidebarButtonSelected" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
            <Setter Property="BackgroundColor" Value="#374151"/>
        </Style>
    </ContentPage.Resources>

    <Grid ColumnDefinitions="200,*">
        <!-- Sidebar -->
        <Grid BackgroundColor="#3A3A3A" Padding="20" RowDefinitions="*,Auto">
            <VerticalStackLayout Spacing="12" Grid.Row="0">
                <Label Text="📦 Inventory"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="White"
                       Margin="0,0,0,20"/>

                <Button x:Name="DashboardBtn"
                        Text="🏠 Dashboard"
                        Style="{StaticResource SidebarButton}"
                        Clicked="DashboardBtn_Clicked"/>

                <Button x:Name="ProductsBtn"
                        Text="📋 Products"
                        Style="{StaticResource SidebarButton}"
                        Clicked="ProductsBtn_Clicked"/>

                <Button x:Name="SuppliersBtn"
                        Text="📦 Suppliers"
                        Style="{StaticResource SidebarButton}"
                        Clicked="SuppliersBtn_Clicked"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="1" HorizontalOptions="Center" Spacing="2" Margin="0,20,0,0">
                <ImageButton x:Name="LogoutBtn"
                             Source="logout.png"
                             WidthRequest="32"
                             HeightRequest="32"
                             BackgroundColor="Transparent"
                             HorizontalOptions="Center"
                             Clicked="LogoutBtn_Clicked"/>
                <Label Text="Logout"
                       FontSize="12"
                       TextColor="#D1D5DB"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>
        <ScrollView Grid.Column="1" Padding="20">
            <Grid>
                <!-- Dashboard Section -->
                <VerticalStackLayout x:Name="DashboardSection" IsVisible="True" Spacing="20">
                    <Border BackgroundColor="White" Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout>
                            <Label Text="📊 Dashboard Overview"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#111827"/>
                            <Label x:Name="TotalProductsNum" FontSize="16" TextColor="#374151"/>
                            <Label x:Name="LowStockNum" FontSize="16" TextColor="#DC2626"/>
                            <Label x:Name="PendingOrderNum" FontSize="16" TextColor="#2563EB"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Orders Panel -->
                    <Border BackgroundColor="White" Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="12">
                            <Label Text="📦 Upcoming Orders"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#111827"/>
                            <CollectionView ItemsSource="{Binding StaffViewModel.OrdersList}" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="entities:Order">
                                        <Border BackgroundColor="#F3F4F6"
                                                Padding="20"
                                                Stroke="#D1D5DB"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle">
                                            <VerticalStackLayout>
                                                <Label Text="{Binding Id, StringFormat='Order #{0}'}"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       TextColor="#111827" />

                                                <Label Text="{Binding Supplier.SupplierName, StringFormat='Supplier Name: {0}'}"
                                                       FontSize="16"
                                                       TextColor="#374151" 
                                                       FontAttributes="Bold"/>

                                                <Label Text="{Binding ProductName, StringFormat='Product Name: {0}'}"
                                                       FontSize="14"
                                                       TextColor="#374151" 
                                                       FontAttributes="Bold"/>
                                                
                                                <Label Text="{Binding SupplierId, StringFormat='Supplier Id: {0}'}"
                                                       FontSize="14"
                                                       TextColor="#374151" />
                                                
                                                <Label Text="{Binding OrderStatus, StringFormat='Status: {0}'}"
                                                       FontSize="14"
                                                       TextColor="#F59E0B" />

                                                <Label Text="{Binding ExpectedDeliveryDate, StringFormat='Due Date: {0:MMM d, yyyy}'}"
                                                       FontSize="14"
                                                       TextColor="#4B5563" />

                                                <Button Text="Reorder"
                                                        BackgroundColor="#3B82F6"
                                                        TextColor="White"
                                                        CornerRadius="6"
                                                        Padding="10,6"
                                                        HorizontalOptions="Start"
                                                        Clicked="ReorderBtn_Clicked"
                                                        CommandParameter="{Binding .}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

                <!-- Products -->
                <VerticalStackLayout x:Name="ProductsSection" IsVisible="False" Spacing="20">
                    <Border BackgroundColor="White" Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="15">

                            <Grid ColumnDefinitions="*,Auto" Padding="0,0,0,10">
                                <Label Text="📋 Products"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="#111827"
                                       VerticalOptions="Center"/>
                                <Button Text="Add Product"
                                        BackgroundColor="#3B82F6"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        CornerRadius="8"
                                        Padding="15,6"
                                        HorizontalOptions="End"
                                        Clicked="ShowProductPopup"/>
                            </Grid>

                            <Grid ColumnDefinitions="2*,2*,Auto,2*,2*"
                                  Padding="10,8"
                                  ColumnSpacing="15"
                                  BackgroundColor="#F3F4F6">
                                <Label Text="Name" FontAttributes="Bold" TextColor="#111827" />
                                <Label Text="Category" Grid.Column="1" FontAttributes="Bold" TextColor="#111827" />
                                <Label Text="Stock" Grid.Column="2" FontAttributes="Bold" TextColor="#111827" />
                                <Label Text="Edit" Grid.Column="3" FontAttributes="Bold" TextColor="#111827" HorizontalOptions="Center" />
                                <Label Text="Delete" Grid.Column="4" FontAttributes="Bold" TextColor="#111827" HorizontalOptions="Center" />
                            </Grid>

                            <CollectionView ItemsSource="{Binding StaffViewModel.ProductList}" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="entities:Product">
                                        <Grid ColumnDefinitions="2*,2*,Auto,2*,2*"
                                              Padding="10,8"
                                              ColumnSpacing="15"
                                              BackgroundColor="White"
                                              Margin="0,0,0,10">
                                            <Label Text="{Binding Name}" Grid.Column="0" TextColor="#111827"/>
                                            <Label Text="{Binding Category}" Grid.Column="1" TextColor="#374151"/>
                                            <Label Text="{Binding Stock}" Grid.Column="2" TextColor="#4B5563"/>

                                            <ImageButton Grid.Column="3"
                                                         Source="edit.png"
                                                         BackgroundColor="Transparent"
                                                         WidthRequest="20"
                                                         HeightRequest="20"
                                                         HorizontalOptions="Center"
                                                         Clicked="Edit_Button"
                                                         CommandParameter="{Binding .}" />

                                            <ImageButton Grid.Column="4"
                                                         Source="delete.png"
                                                         BackgroundColor="Transparent"
                                                         WidthRequest="20"
                                                         HeightRequest="20"
                                                         HorizontalOptions="Center"
                                                         Clicked="Delete_Button"
                                                         CommandParameter="{Binding .}" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Suppliers -->
                <VerticalStackLayout x:Name="SuppliersSection" IsVisible="False" Spacing="20">
                    <Border BackgroundColor="White" Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <pages:SupplierPage />
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
