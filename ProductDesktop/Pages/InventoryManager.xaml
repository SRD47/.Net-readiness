<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ProductDesktop.Pages.InventoryManager"
    Title="Inventory Manager"
    BackgroundColor="#F3F4F6">

    <ContentPage.Resources>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="#1F2937" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="HorizontalOptions" Value="Fill" />
            <Setter Property="Margin" Value="0,6" />
        </Style>
    </ContentPage.Resources>

    <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,*" Padding="0">

        <!-- Sidebar -->
        <StackLayout Grid.RowSpan="2" BackgroundColor="White" Padding="20">
            <Label Text="?? Inventory" FontSize="22" FontAttributes="Bold" TextColor="#111827" Margin="0,0,0,20"/>
            <Button Text="Dashboard" Style="{StaticResource SidebarButton}" />
            <Button Text="Inventory" Style="{StaticResource SidebarButton}" />
            <Button Text="Reports" Style="{StaticResource SidebarButton}" />
            <Button Text="Settings" Style="{StaticResource SidebarButton}" />
        </StackLayout>

        <!-- Header -->
        <Grid Grid.Column="1" Padding="20" BackgroundColor="#FFFFFF" VerticalOptions="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Label
                Text="Inventory Manager"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="#1F2937"
                VerticalOptions="Center" />

            <Button
                Grid.Column="1"
                Text="+ Add Item"
                BackgroundColor="#2563EB"
                TextColor="White"
                FontSize="16"
                FontAttributes="Bold"
                CornerRadius="10"
                Padding="20,10"
                VerticalOptions="Center" />
        </Grid>

        <!-- Main Content -->
        <StackLayout Grid.Column="1" Grid.Row="1" Padding="20" Spacing="20">

            <!-- Search Bar inside Border -->
            <Border
                BackgroundColor="White"
                Padding="10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="2,2" Radius="6" Opacity="0.1" />
                </Border.Shadow>

                <SearchBar
                    Placeholder="Search inventory..."
                    BackgroundColor="Transparent"
                    TextColor="#111827"
                    PlaceholderColor="#9CA3AF"
                    HeightRequest="45"
                    FontSize="16" />
            </Border>

            <!-- Inventory Items -->
            <CollectionView
                ItemsSource="{Binding ProductList}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            BackgroundColor="White"
                            Padding="15"
                            Margin="0,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="15" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="2,2" Radius="5" Opacity="0.15" />
                            </Border.Shadow>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Product Info -->
                                <StackLayout>
                                    <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="#1E293B" />
                                    <Label Text="{Binding Quantity, StringFormat='Quantity: {0}'}" FontSize="14" TextColor="#6B7280" />
                                    <Label Text="In Stock" FontSize="12" FontAttributes="Italic" TextColor="Green" />
                                </StackLayout>

                                <!-- Edit Button -->
                                <ImageButton
                                    Grid.Column="1"
                                    Source="edit.png"
                                    BackgroundColor="#DBEAFE"
                                    HeightRequest="40"
                                    WidthRequest="40"
                                    CornerRadius="8"
                                    Padding="6"
                                    Clicked="Edit_Button" />

                                <!-- Delete Button -->
                                <ImageButton
                                    Grid.Column="2"
                                    Source="delete.png"
                                    BackgroundColor="#FECACA"
                                    HeightRequest="40"
                                    WidthRequest="40"
                                    CornerRadius="8"
                                    Padding="6"
                                    Clicked="Delete_Button" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </StackLayout>
    </Grid>
</ContentPage>
