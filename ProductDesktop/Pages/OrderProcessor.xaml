<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProductDesktop.Pages.OrderProcessor"
             BackgroundColor="#F4F6F8"
             Title="Order Processor">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="📦 Incoming Orders"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="#1A237E"
                   Margin="0,0,0,10" />

            <Border Stroke="#D1D9E6"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="White"
                    Padding="20"
                    Margin="0,0,0,10">

                <VerticalStackLayout Spacing="16">

                    <Label Text="Order ID: ORD12345"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#2C3E50" />

                    <HorizontalStackLayout Spacing="6">
                        <Label Text="👤"
                               FontSize="16" />
                        <Label Text="John Doe"
                               FontSize="16"
                               TextColor="#37474F" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="6">
                        <Label Text="🕒"
                               FontSize="14" />
                        <Label Text="Aug 22, 2025 10:00 AM"
                               FontSize="14"
                               TextColor="#607D8B" />
                    </HorizontalStackLayout>

                    <VerticalStackLayout>
                        <Label Text="📝 Items:"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#455A64"
                               Margin="0,0,0,5" />
                        <Label Text="• 2x Apples\n• 1x Banana"
                               FontSize="15"
                               TextColor="#546E7A"
                               LineHeight="1.3" />
                    </VerticalStackLayout>

                    <HorizontalStackLayout Spacing="12"
                                           Margin="0,10,0,0">
                        <Button Text="✅ Mark as Processed"
                                BackgroundColor="#43A047"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="14"
                                Padding="10,6"
                                CornerRadius="10" />

                        <Button Text="❌ Cancel"
                                BackgroundColor="#E53935"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="14"
                                Padding="10,6"
                                CornerRadius="10"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
