<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProductDesktop.Pages.CustomerDashboard"
             BackgroundColor="#F5F7FA"
             Padding="0">

    <ScrollView>
        <Grid ColumnDefinitions="3*, 1.2*" RowDefinitions="Auto,*" Padding="20">

            <!-- Header -->
            <Label Text="👋 Welcome, User"
                   Grid.ColumnSpan="2"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#1A237E"
                   Margin="0,0,0,20" />

            <!-- Product Grid -->
            <Grid Grid.Column="0"
                  Grid.Row="1"
                  BackgroundColor="#FAFAFA"
                  Padding="10"
                  RowDefinitions="Auto, *">

                <CollectionView ItemsSource="{Binding ProductList}"
                                SelectionMode="Single"
                                SelectionChangedCommand="{Binding SelectedProduct}">

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Stroke="#DADADA"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    BackgroundColor="White"
                                    Margin="10"
                                    Shadow="Medium"
                                    Padding="15">

                                <VerticalStackLayout Spacing="12"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Center">

                                    <!-- Product Image Placeholder -->
                                    <Image Source="product_placeholder.png"
                                           WidthRequest="120"
                                           HeightRequest="120"
                                           Aspect="AspectFill"
                                           BackgroundColor="#F0F0F0" />

                                    <!-- Product Name -->
                                    <Label Text="{Binding Name}"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="#263238"
                                           HorizontalTextAlignment="Center" />

                                    <!-- Price Row -->
                                    <HorizontalStackLayout HorizontalOptions="Center"
                                                           Spacing="6"
                                                           VerticalOptions="Center">
                                        <Label Text="💰"
                                               FontSize="16"
                                               VerticalOptions="Center" />
                                        <Label Text="Price:"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#00796B" />
                                        <Label Text="{Binding Currency}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#00796B" />
                                        <Label Text="{Binding Price, StringFormat=' {0:F2}'}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#00796B" />
                                    </HorizontalStackLayout>

                                    <!-- Cart Button -->
                                    <Button ImageSource="cart.png"
                                            WidthRequest="52"
                                            HeightRequest="52"
                                            BackgroundColor="#26A69A"
                                            CornerRadius="26"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            Clicked="Cart_Clicked"
                                            CommandParameter="{Binding .}">
                                        <Button.Shadow>
                                            <Shadow Brush="Gray" Offset="0,2" Radius="5" />
                                        </Button.Shadow>
                                    </Button>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <!-- Selected Products Panel -->
            <Border Grid.Column="1"
                    Grid.Row="1"
                    Stroke="#D1D1D6"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="White"
                    Padding="15"
                    Margin="10">

                <!-- Updated RowDefinitions to include 4 rows -->
                <Grid RowDefinitions="Auto,*,Auto,Auto">

                    <!-- Header -->
                    <Label Text="🛒 Selected Products"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#263238"
                           Margin="0,0,0,10" />

                    <!-- Selected Products List -->
                    <CollectionView Grid.Row="1"
                                    ItemsSource="{Binding SelectedProduct}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="2*,Auto,Auto"
                                      Padding="5"
                                      Margin="0,0,0,5">
                                    <Label Text="{Binding Name}"
                                           FontSize="14"
                                           TextColor="#2C3E50" />
                                    <Label Text="x1"
                                           Grid.Column="1"
                                           FontSize="14"
                                           HorizontalOptions="End"
                                           TextColor="#607D8B" />
                                    <Label Text="{Binding Price, StringFormat='Rs {0:F2}'}"
                                           Grid.Column="2"
                                           FontSize="14"
                                           HorizontalOptions="End"
                                           TextColor="#00796B" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Total Price -->
                    <Grid Grid.Row="2"
                          ColumnDefinitions="*,Auto"
                          Padding="10,5,0,0"
                          Margin="0,10,0,0"
                          BackgroundColor="#E0F2F1">
                        <Label Text="Total"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#004D40" />
                        <Label Text="{Binding TotalAmount, StringFormat='Rs {0:F2}'}"
                               Grid.Column="1"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#004D40"
                               HorizontalOptions="End" />
                    </Grid>

                    <!-- Place Order Button -->
                    <Button Text="✅ Place Order"
                            Grid.Row="3"
                            Margin="0,15,0,0"
                            BackgroundColor="#388E3C"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="16"
                            Padding="12,8"
                            CornerRadius="8"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
