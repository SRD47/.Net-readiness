<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProductDesktop.Pages.LoginPage"
             Title="✨ Welcome Back"
             BackgroundColor="#F0F4F8">
    <ScrollView>
        <Grid RowDefinitions="*,Auto,*" Padding="20">

            <!-- Center Card -->
            <Border Grid.Row="1"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 20"
                    Stroke="#D1D1D6"
                    Padding="30"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="#000000"
                            Opacity="0.1"
                            Offset="4,4"
                            Radius="12"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="25" WidthRequest="400">

                    <!-- Title -->
                    <Label Text="Welcome Back 👋"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="#1C1C1E"
                           HorizontalOptions="Center"/>

                    <!-- Subtitle -->
                    <Label Text="Login to continue to your account"
                           FontSize="16"
                           TextColor="#6E7D88"
                           HorizontalOptions="Center"/>

                    <!-- Username -->
                    <VerticalStackLayout>
                        <Label Text="Username"
                               FontSize="14"
                               TextColor="#1C1C1E"
                               Margin="0,0,0,5"/>
                        <Entry x:Name="get_username"
                               Placeholder="Enter your username"
                               BackgroundColor="#F8FAFC"
                               TextColor="#1C1C1E"
                               HeightRequest="45"
                               ClearButtonVisibility="WhileEditing"
                               Keyboard="Email"
                               Margin="0"/>
                    </VerticalStackLayout>

                    <!-- Password -->
                    <VerticalStackLayout>
                        <Label Text="Password"
                               FontSize="14"
                               TextColor="#1C1C1E"
                               Margin="0,0,0,5"/>
                        <Entry x:Name="get_password"
                               Placeholder="Enter your password"
                               IsPassword="True"
                               BackgroundColor="#F8FAFC"
                               TextColor="#1C1C1E"
                               HeightRequest="45"/>
                    </VerticalStackLayout>

                    <!-- Forgot Password -->
                    <Label Text="Forgot Password?"
                           FontSize="13"
                           TextColor="#4CAF50"
                           HorizontalOptions="End">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="ForgotPassword_Tapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- Login Button -->
                    <Button Text="🚀 Login"
                            BackgroundColor="#4CAF50"
                            TextColor="White"
                            CornerRadius="25"
                            HeightRequest="50"
                            FontSize="16"
                            FontAttributes="Bold"
                            Clicked="OnClick"/>

                    <!-- Divider -->
                    <Grid ColumnDefinitions="*,Auto,*" VerticalOptions="Center">
                        <BoxView HeightRequest="1" BackgroundColor="#D1D1D6" Margin="0,10"/>
                        <Label Text="or" Grid.Column="1" Padding="10,0" TextColor="#6E7D88"/>
                        <BoxView HeightRequest="1" BackgroundColor="#D1D1D6" Grid.Column="2" Margin="0,10"/>
                    </Grid>

                    <!-- Signup Redirect -->
                    <Label Text="Don't have an account? Sign up"
                           HorizontalOptions="Center"
                           TextColor="#2C6E49"
                           FontSize="14">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
