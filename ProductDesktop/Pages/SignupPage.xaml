<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProductDesktop.Pages.SignupPage"
             Title="✨ Create Your Account"
             BackgroundColor="#F5F3FF">
    <!-- Changed background -->

    <ScrollView>
        <Grid RowDefinitions="*,Auto,*" Padding="20">

            <!-- Signup Card -->
            <Border Grid.Row="1"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 20"
                    Stroke="#D1D1D6"
                    Padding="30"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="#000000" Opacity="0.1" Offset="4,4" Radius="12"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="25" WidthRequest="400">

                    <!-- Title -->
                    <Label Text="Create a New Profile"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="#1C1C1E"
                           HorizontalOptions="Center"/>

                    <!-- Subtitle -->
                    <Label Text="Sign up to get started 🚀"
                           FontSize="15"
                           TextColor="#6E7D88"
                           HorizontalOptions="Center"/>

                    <!-- Name -->
                    <VerticalStackLayout>
                        <Label Text="Full Name"
                               FontSize="14"
                               TextColor="#1C1C1E"
                               Margin="0,0,0,5"/>
                        <Entry x:Name="nameLabel"
                               Placeholder="Enter your name"
                               BackgroundColor="#F8FAFC"
                               TextColor="#1C1C1E"
                               HeightRequest="45"/>
                    </VerticalStackLayout>

                    <!-- Username -->
                    <VerticalStackLayout>
                        <Label Text="Username"
                               FontSize="14"
                               TextColor="#1C1C1E"
                               Margin="0,0,0,5"/>
                        <Entry x:Name="username"
                               Placeholder="Enter your username"
                               BackgroundColor="#F8FAFC"
                               TextColor="#1C1C1E"
                               HeightRequest="45"/>
                    </VerticalStackLayout>

                    <!-- Password -->
                    <VerticalStackLayout>
                        <Label Text="Password"
                               FontSize="14"
                               TextColor="#1C1C1E"
                               Margin="0,0,0,5"/>
                        <Entry x:Name="password"
                               Placeholder="Enter your password"
                               IsPassword="True"
                               BackgroundColor="#F8FAFC"
                               TextColor="#1C1C1E"
                               HeightRequest="45"/>
                    </VerticalStackLayout>

                    <!-- Confirm Password -->
                    <VerticalStackLayout>
                        <Label Text="Confirm Password"
                               FontSize="14"
                               TextColor="#1C1C1E"
                               Margin="0,0,0,5"/>
                        <Entry x:Name="confirm_password"
                               Placeholder="Re-enter your password"
                               IsPassword="True"
                               BackgroundColor="#F8FAFC"
                               TextColor="#1C1C1E"
                               HeightRequest="45"/>
                    </VerticalStackLayout>

                    <!-- Signup Button -->
                    <Button Text="✨ Sign Up"
                            BackgroundColor="#4CAF50"
                            TextColor="White"
                            CornerRadius="25"
                            HeightRequest="50"
                            FontAttributes="Bold"
                            FontSize="16"
                            Clicked="Button_Clicked"/>

                    <!-- Already Have Account -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="Already have an account?"
                               FontSize="13"
                               TextColor="#6E7D88"/>
                        <Label Text="Login"
                               FontSize="13"
                               TextColor="#2C6E49"
                               FontAttributes="Bold">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Login_Tapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
