<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="ProductDesktop.Pages.EditProductPopup"
    CanBeDismissedByTappingOutsideOfPopup="True"
    WidthRequest="600"
    HeightRequest="500">

    <Border
        BackgroundColor="White"
        Stroke="#E5E7EB"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 16"
        Padding="0"
        Margin="0">

        <Grid>
            <ImageButton
                Source="close.png"
                BackgroundColor="Transparent"
                WidthRequest="32"
                HeightRequest="32"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="12"
                Clicked="CloseButton_Clicked"/>

            <ScrollView Margin="20,48,20,20">
                <VerticalStackLayout Spacing="16">

                    <Label Text="Edit Product"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="#111827" />

                    <Label Text="Product Name:"
                           FontSize="14"
                           TextColor="#111827"
                           HorizontalOptions="Start" />
                    <Entry x:Name="Name_Entry"
                           Text="{Binding Name, Mode=TwoWay}"
                           Placeholder="Enter product name"
                           FontSize="14"
                           BackgroundColor="#F3F4F6"
                           TextColor="#111827"/>

                    <Label Text="Category:"
                           FontSize="14"
                           TextColor="#111827"
                           HorizontalOptions="Start" />
                    <Picker x:Name="Category_Picker"
                            ItemsSource="{Binding Categories}"
                            SelectedItem="{Binding Category, Mode=TwoWay}"
                            FontSize="14"
                            TextColor="#111827"
                            BackgroundColor="#E5E7EB"/>

                    <Label Text="Price:"
                           FontSize="14"
                           TextColor="#111827"
                           HorizontalOptions="Start" />
                    <Entry x:Name="Price_Entry"
                           Text="{Binding Price, Mode=TwoWay}"
                           Placeholder="Enter price"
                           Keyboard="Numeric"
                           FontSize="14"
                           BackgroundColor="#F3F4F6"
                           TextColor="#111827"/>

                    <Label Text="Currency:"
                           FontSize="14"
                           TextColor="#111827"
                           HorizontalOptions="Start" />
                    <Picker x:Name="Currency_Picker"
                            ItemsSource="{Binding Currencies}"
                            SelectedItem="{Binding Currency, Mode=TwoWay}"
                            FontSize="14"
                            TextColor="#111827"
                            BackgroundColor="#E5E7EB"/>

                    <Label Text="Stock Quantity:"
                           FontSize="14"
                           TextColor="#111827"
                           HorizontalOptions="Start" />
                    <Entry x:Name="Stock_Entry"
                           Text="{Binding Stock, Mode=TwoWay}"
                           Placeholder="Enter stock count"
                           Keyboard="Numeric"
                           FontSize="14"
                           BackgroundColor="#F3F4F6"
                           TextColor="#111827"/>

                    <HorizontalStackLayout Spacing="10" HorizontalOptions="End">
                        <Button Text="Cancel"
                                BackgroundColor="#9CA3AF"
                                TextColor="White"
                                Padding="12,6"
                                CornerRadius="6"
                                Clicked="CancelBtn"/>

                        <Button Text="Save"
                                BackgroundColor="#2563EB"
                                TextColor="White"
                                Padding="12,6"
                                CornerRadius="6"
                                Clicked="SaveBtn"/>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Border>
</toolkit:Popup>
