<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="ProductDesktop.Pages.EditProductPopup"
    CanBeDismissedByTappingOutsideOfPopup="True">

    <Border
        BackgroundColor="White"
        Stroke="#E5E7EB"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 16"
        WidthRequest="500"
        HeightRequest="500"
        Padding="20">

        <Grid RowDefinitions="Auto,*">

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                <Label Text="✏️ Edit Product"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#111827"
                       VerticalOptions="Center" />

                <ImageButton Source="close.png"
                             WidthRequest="24"
                             HeightRequest="24"
                             BackgroundColor="Transparent"
                             HorizontalOptions="End"
                             VerticalOptions="Center"
                             Clicked="CloseButton_Clicked" />
            </Grid>

            <!-- Scrollable Content -->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="14">

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Product Name"
                               FontSize="14"
                               TextColor="#374151" />
                        <Border Stroke="#E5E7EB"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="#F3F4F6">
                            <Entry x:Name="Name_Entry"
                                   Placeholder="Enter product name"
                                   Text="{Binding Name, Mode=TwoWay}"
                                   TextColor="#111827"
                                   BackgroundColor="Transparent"
                                   Margin="8,4" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Category"
                               FontSize="14"
                               TextColor="#374151" />
                        <Border Stroke="#E5E7EB"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="#F3F4F6">
                            <Entry x:Name="Category_Entry"
                                   Placeholder="Enter category"
                                   Text="{Binding Category, Mode=TwoWay}"
                                   TextColor="#111827"
                                   BackgroundColor="Transparent"
                                   Margin="8,4" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Price"
                               FontSize="14"
                               TextColor="#374151" />
                        <Border Stroke="#E5E7EB"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="#F3F4F6">
                            <Entry x:Name="Price_Entry"
                                   Placeholder="Enter price"
                                   Keyboard="Numeric"
                                   Text="{Binding Price, Mode=TwoWay}"
                                   TextColor="#111827"
                                   BackgroundColor="Transparent"
                                   Margin="8,4" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Currency"
                               FontSize="14"
                               TextColor="#374151" />
                        <Border Stroke="#E5E7EB"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="#F3F4F6">
                            <Entry x:Name="Currency_Entry"
                                   Placeholder="Enter currency (e.g. USD)"
                                   Text="{Binding Currency, Mode=TwoWay}"
                                   TextColor="#111827"
                                   BackgroundColor="Transparent"
                                   Margin="8,4" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Stock Quantity"
                               FontSize="14"
                               TextColor="#374151" />
                        <Border Stroke="#E5E7EB"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="#F3F4F6">
                            <Entry x:Name="Stock_Entry"
                                   Placeholder="Enter stock count"
                                   Keyboard="Numeric"
                                   Text="{Binding Stock, Mode=TwoWay}"
                                   TextColor="#111827"
                                   BackgroundColor="Transparent"
                                   Margin="8,4" />
                        </Border>
                    </VerticalStackLayout>

                    <HorizontalStackLayout Spacing="10"
                                           HorizontalOptions="End"
                                           Margin="0,10,0,0">
                        <Button Text="Cancel"
                                BackgroundColor="#9CA3AF"
                                TextColor="White"
                                CornerRadius="8"
                                Clicked="CancelBtn" />

                        <Button Text="Save"
                                BackgroundColor="#2563EB"
                                TextColor="White"
                                CornerRadius="8"
                                Clicked="SaveBtn" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Border>
</toolkit:Popup>
