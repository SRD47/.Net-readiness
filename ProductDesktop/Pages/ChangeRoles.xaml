<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProductDesktop.Pages.ChangeRoles"
             Title="Change Roles"
             BackgroundColor="#f2f2f2">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Staffs List"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" 
                   TextColor="Black"/>
            <CollectionView ItemsSource="{Binding Userlist}" Margin="0,10,0,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="LightGray"
                                StrokeThickness="1"
                                BackgroundColor="White"
                                Padding="15"
                                StrokeShape="RoundRectangle 10"
                                Margin="0,10"
                                Shadow="Small">

                            <VerticalStackLayout Spacing="10">
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="Name:"  
                                       FontAttributes="Bold"
                                       FontSize="18"
                                       TextColor="Black" />
                                    <Label Text="{Binding Name}"  
                                       FontAttributes="Bold"
                                       FontSize="18"
                                       TextColor="Black" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="Username:"
                                       FontSize="14"
                                       TextColor="Gray" />
                                    <Label Text="{Binding Username}"
                                       FontSize="14"
                                       TextColor="Gray" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout>
                                    <Label Text="Current Role:" 
                                           VerticalTextAlignment="Center"
                                           TextColor="Black" />
                                    <Picker WidthRequest="200"
                                            BackgroundColor="#eeeeee"
                                            SelectedItem="{Binding Roles}"
                                            TextColor="Black">
                                        <Picker.Items>
                                            <x:String>Admin</x:String>
                                                <x:String>Inventory Manager</x:String>
                                                <x:String>Order Processor</x:String>
                                            <x:String>Customer</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
