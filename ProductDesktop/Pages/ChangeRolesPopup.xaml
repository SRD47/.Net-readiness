<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="ProductDesktop.Pages.ChangeRolesPopup"
               BackgroundColor="#EDF2F7">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="20">
            <Label Text="👥 Staff Roles"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#2D3748" />

            <CollectionView ItemsSource="{Binding Userlist}" Margin="0,10,0,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="#CBD5E0"
                                StrokeThickness="1"
                                BackgroundColor="White"
                                Padding="18"
                                StrokeShape="RoundRectangle 12"
                                Margin="0,10"
                                Shadow="0.3">
                            <VerticalStackLayout Spacing="14">
                                <!-- Name -->
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="💼"
                                           FontSize="18"
                                           VerticalTextAlignment="Center" />
                                    <Label Text="{Binding Name}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#1A202C" />
                                </HorizontalStackLayout>

                                <!-- Username -->
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="📛"
                                           FontSize="14"
                                           VerticalTextAlignment="Center" />
                                    <Label Text="{Binding Username}"
                                           FontSize="14"
                                           TextColor="#4A5568" />
                                </HorizontalStackLayout>

                                <!-- Role -->
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="🎖️"
                                           FontSize="14"
                                           TextColor="#2D3748"
                                           VerticalTextAlignment="Center" />
                                    <Label Text="{Binding Roles}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#5A67D8"  
                                           HorizontalOptions="Start" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Close"
                    Padding="12,8"
                    CornerRadius="10"
                    BackgroundColor="#E53E3E" 
                    TextColor="White"
                    FontAttributes="Bold"
                    Clicked="Close_Popup" />
        </VerticalStackLayout>
    </ScrollView>
</toolkit:Popup>
