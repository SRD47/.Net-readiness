<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="ProductDesktop.Pages.ChangeRolesPopup"
             BackgroundColor="#f2f2f2">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Staffs List"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" 
                   TextColor="Black"/>
            <CollectionView ItemsSource="{Binding Userlist}" Margin="0,10,0,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="LightGray"
                                StrokeThickness="1"
                                BackgroundColor="White"
                                Padding="15"
                                StrokeShape="RoundRectangle 10"
                                Margin="0,10"
                                Shadow="Small">

                            <VerticalStackLayout Spacing="10">
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="Name:"  
                                       FontAttributes="Bold"
                                       FontSize="18"
                                       TextColor="Black" />
                                    <Label Text="{Binding Name}"  
                                       FontAttributes="Bold"
                                       FontSize="18"
                                       TextColor="Black" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="Username:"
                                       FontSize="14"
                                       TextColor="Gray" />
                                    <Label Text="{Binding Username}"
                                       FontSize="14"
                                       TextColor="Gray" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="20">
                                    <Label Text="Current Role:" 
                                           VerticalTextAlignment="Center"
                                           TextColor="Black" />
                                    <Label Text="{Binding Roles}"
                                           WidthRequest="200"
                                           TextColor="LightCoral"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           />
                                </HorizontalStackLayout>
                                
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Button Text="Close" Padding="10,0" BackgroundColor="LightCoral" Clicked="Close_Popup"/>
        </VerticalStackLayout>
    </ScrollView>
</toolkit:Popup>
