<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Name="PopupRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:ProductDesktop.ViewModel"
    xmlns:entities="clr-namespace:ProductDesktop.Entities"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="ProductDesktop.Pages.ChangeRolesPopup"
    x:DataType="viewmodel:MainViewModel"
    BackgroundColor="#EFEFFC">

    <Border
        BackgroundColor="White"
        Stroke="#D1D5DB"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 20"
        Padding="24"
        Shadow="0.3"
        VerticalOptions="Center"
        HorizontalOptions="Center"
        WidthRequest="750"
        HeightRequest="600">

        <Grid RowDefinitions="Auto, *">
            <Button Text="✕"
                    FontSize="20"
                    BackgroundColor="Transparent"
                    TextColor="#9CA3AF"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    WidthRequest="36"
                    HeightRequest="36"
                    CornerRadius="18"
                    Clicked="Close_Popup" />

            <ScrollView Grid.Row="1" Margin="0,10,0,0">
                <VerticalStackLayout Spacing="22">

                    <Label Text="👥 Manage Staff Roles"
                           FontSize="26"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="#4F46E5" />

                    <BoxView HeightRequest="1" BackgroundColor="#D8DAE5" />

                    <CollectionView ItemsSource="{Binding StaffViewModel.UserList}" Margin="0">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="entities:AppUsers">
                                <Border Stroke="#E5E7EB"
                                        BackgroundColor="#F9FAFB"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 12"
                                        Margin="0,6"
                                        Padding="16"
                                        Shadow="0.1">

                                    <VerticalStackLayout Spacing="14">

                                        <Grid ColumnDefinitions="Auto, *"
                                              RowDefinitions="Auto, Auto"
                                              ColumnSpacing="10"
                                              RowSpacing="6">

                                            <Label Grid.Row="0" Grid.Column="0"
                                                   Text="Name:"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="#4B5563" />
                                            <Label Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="#1F2937" />

                                            <Label Grid.Row="1" Grid.Column="0"
                                                   Text="Username:"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="#6B7280" />
                                            <Label Grid.Row="1" Grid.Column="1"
                                                   Text="{Binding Username}"
                                                   FontSize="14"
                                                   TextColor="#6B7280" />
                                        </Grid>

                                        <StackLayout Spacing="6">
                                            <Label Text="Current Role:"
                                                   FontSize="14"
                                                   TextColor="#6B7280"
                                                   FontAttributes="Bold" />
                                            <Border Stroke="#C7D2FE"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 8"
                                                    BackgroundColor="#E0E7FF"
                                                    Padding="10,6">
                                                <Entry Text="{Binding Roles}"
                                                       IsReadOnly="True"
                                                       BackgroundColor="Transparent"
                                                       TextColor="#3730A3"
                                                       FontSize="14" />
                                            </Border>
                                        </StackLayout>

                                        <StackLayout Spacing="6">
                                            <Label Text="Select New Role:"
                                                   FontSize="14"
                                                   TextColor="#4B5563"
                                                   FontAttributes="Bold"/>
                                            <Picker 
                                                ItemsSource="{Binding BindingContext.EnumViewModel.Rolesbind, Source={x:Reference PopupRoot}}"
                                                SelectedItem="{Binding NewRole}"
                                                Title="Choose role"
                                                TitleColor="#9CA3AF"
                                                TextColor="#1E3A8A"
                                                FontSize="14"
                                                BackgroundColor="#EEF2FF"
                                                Margin="0,0,0,5" />
                                        </StackLayout>

                                        <HorizontalStackLayout Spacing="10" HorizontalOptions="End">
                                            <Button Text="Cancel"
                                                    Padding="10,6"
                                                    CornerRadius="8"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#9CA3AF"
                                                    FontAttributes="Bold"
                                                    Clicked="Close_Popup" />
                                            <Button Text="Update Role"
                                                    Padding="10,6"
                                                    CornerRadius="8"
                                                    BackgroundColor="#6366F1"
                                                    TextColor="White"
                                                    FontAttributes="Bold"
                                                    FontSize="14"
                                                    Command="{Binding BindingContext.EnumViewModel.RolesCommand, Source={x:Reference PopupRoot}}"
                                                    CommandParameter="{Binding .}" />
                                        </HorizontalStackLayout>

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Border>
</toolkit:Popup>
