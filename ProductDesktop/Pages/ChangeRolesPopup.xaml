<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Name="PopupRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:ProductDesktop.ViewModel"
    xmlns:entities="clr-namespace:ProductDesktop.Entities"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="ProductDesktop.Pages.ChangeRolesPopup"
    x:DataType="viewmodel:MainViewModel"
    BackgroundColor="#F9FAFB">

    <Grid Padding="25">

        <!-- Close button top right -->
        <Button Text="✕"
                FontSize="22"
                BackgroundColor="Transparent"
                TextColor="#6B7280"
                HorizontalOptions="End"
                VerticalOptions="Start"
                WidthRequest="40"
                HeightRequest="40"
                CornerRadius="20"
                Clicked="Close_Popup" />

        <ScrollView Grid.Row="1" Margin="0,40,0,0">
            <VerticalStackLayout Spacing="20">

                <!-- Header -->
                <Label Text="👥 Manage Staff Roles"
                       FontSize="28"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="#1F2937" />

                <!-- User List -->
                <CollectionView ItemsSource="{Binding StaffViewModel.UserList}" Margin="0,10,0,0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="entities:AppUsers">
                            <Border Stroke="#E5E7EB"
                                    BackgroundColor="White"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    Margin="0,10"
                                    Padding="18"
                                    Shadow="0.2">

                                <VerticalStackLayout Spacing="16">

                                    <!-- Top row: Name and username with labels -->
                                    <Grid ColumnSpacing="12" RowSpacing="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Label Grid.Row="0" Grid.Column="0" Text="Name:"
                                               FontSize="16" FontAttributes="Bold"
                                               VerticalOptions="Center"
                                               TextColor="#374151"/>
                                        <Label Grid.Row="0" Grid.Column="1"
                                               Text="{Binding Name}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="#111827" />

                                        <Label Grid.Row="1" Grid.Column="0" Text="Username:"
                                               FontSize="14" FontAttributes="Bold"
                                               VerticalOptions="Center"
                                               TextColor="#6B7280"/>
                                        <Label Grid.Row="1" Grid.Column="1"
                                               Text="{Binding Username}"
                                               FontSize="14"
                                               TextColor="#6B7280" />
                                    </Grid>

                                    <!-- Current Role Entry wrapped in Border -->
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="Current Role:"
                                               FontSize="14"
                                               TextColor="#6B7280"
                                               FontAttributes="Bold" />
                                        <Border Stroke="#D1D5DB"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 8"
                                                BackgroundColor="#F3F4F6"
                                                Padding="10,6">
                                            <Entry Text="{Binding Roles}"
                                                   IsReadOnly="True"
                                                   BackgroundColor="Transparent"
                                                   TextColor="#374151"
                                                   FontSize="14" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <!-- Role Selection Picker -->
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="Select New Role:"
                                               FontSize="14"
                                               TextColor="#4B5563"
                                               FontAttributes="Bold"/>
                                        <Picker 
                                                ItemsSource="{Binding BindingContext.EnumViewModel.Rolesbind, Source={x:Reference PopupRoot}}"
                                                SelectedItem="{Binding NewRole}"
                                                Title="Choose role"
                                                TitleColor="#9CA3AF"
                                                TextColor="#374151"
                                                FontSize="14"
                                                BackgroundColor="#F3F4F6" />
                                    </VerticalStackLayout>

                                    <!-- Update Button -->
                                    <Button Text="Update Role"
                                            Padding="10,6"
                                            CornerRadius="8"
                                            BackgroundColor="#3B82F6"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            FontSize="14"
                                            HorizontalOptions="Start"
                                            Command="{Binding BindingContext.EnumViewModel.RolesCommand, Source={x:Reference PopupRoot}}"
                                            CommandParameter="{Binding .}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</toolkit:Popup>
