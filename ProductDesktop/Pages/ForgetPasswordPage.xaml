<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProductDesktop.Pages.ForgetPasswordPage"
             BackgroundColor="Transparent"
             Padding="20">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF00C6FF" Offset="0.0" />
            <GradientStop Color="#FF0072FF" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Centered Content -->
            <VerticalStackLayout Grid.Row="1" Spacing="30" HorizontalOptions="Center" WidthRequest="350">

                <!-- App Logo -->
                <Image Source="your_logo.png"
                       HeightRequest="100"
                       WidthRequest="100"
                       HorizontalOptions="Center" />

                <!-- Title -->
                <Label Text="Reset Password"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />

                <Label Text="Fill in your details below to reset your password."
                       FontSize="16"
                       TextColor="#E0E0E0"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,10" />

                <!-- Name Entry -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Name" TextColor="White" FontAttributes="Bold"/>
                    <Border StrokeThickness="0"
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 12"
                            Shadow="Small"
                            Padding="10,5">
                        <Entry x:Name="name_entry"
                               Placeholder="Enter your name"
                               TextColor="#333"
                               PlaceholderColor="#999"
                               BackgroundColor="Transparent" />
                    </Border>
                </VerticalStackLayout>

                <!-- Username Entry -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Username" TextColor="White" FontAttributes="Bold"/>
                    <Border StrokeThickness="0"
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 12"
                            Shadow="Small"
                            Padding="10,5">
                        <Entry x:Name="username_entry"
                               Placeholder="Enter your username"
                               TextColor="#333"
                               PlaceholderColor="#999"
                               BackgroundColor="Transparent" />
                    </Border>
                </VerticalStackLayout>

                <!-- Password Entry -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="New Password" TextColor="White" FontAttributes="Bold"/>
                    <Border StrokeThickness="0"
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 12"
                            Shadow="Small"
                            Padding="10,5">
                        <Entry x:Name="pass_entry"
                               Placeholder="Enter new password"
                               IsPassword="True"
                               TextColor="#333"
                               PlaceholderColor="#999"
                               BackgroundColor="Transparent" />
                    </Border>
                </VerticalStackLayout>

                <!-- Re-enter Password Entry -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Re-enter new Password" TextColor="White" FontAttributes="Bold"/>
                    <Border StrokeThickness="0"
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 12"
                            Shadow="Small"
                            Padding="10,5">
                        <Entry x:Name="re_pass"
                               Placeholder="Re-enter new password"
                               IsPassword="True"
                               TextColor="#333"
                               PlaceholderColor="#999"
                               BackgroundColor="Transparent" />
                    </Border>
                </VerticalStackLayout>

                <!-- Submit Button -->
                <Button Text="Reset Password"
                        CornerRadius="25"
                        HeightRequest="50"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="#FF4ECDC4"
                        Shadow="Small" 
                        Clicked="submit_btn"/>

                <!-- Back to Login -->
                <StackLayout HorizontalOptions="Center" Margin="0,20,0,0">
                    <Label Text="Remember your password?"
                           TextColor="White"
                           FontSize="14"
                           HorizontalOptions="Center" />
                    <Label Text="Back to Login"
                           TextColor="#FFD700"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                </StackLayout>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
